# ──────────────────────────────────────────────
# AGENT-LOCK — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Gemini (Google AI Studio) ──────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# ── Auth0 ──────────────────────────────────────
# Create your account at: https://auth0.com (free tier available)
AUTH0_DOMAIN=YOUR_DOMAIN.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
AUTH0_AUDIENCE=https://agent-lock-api

# ── Telegram ───────────────────────────────────
# 1. Talk to @BotFather on Telegram → /newbot
# 2. Paste the token here
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# 3. Talk to @userinfobot to get your Chat ID
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── Server ─────────────────────────────────────
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ── Security ───────────────────────────────────
SECRET_KEY=change_this_to_a_very_secure_key

# ── Logs ───────────────────────────────────────
AUDIT_LOG_PATH=./logs/audit.jsonl
