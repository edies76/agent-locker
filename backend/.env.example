# ──────────────────────────────────────────────
# AGENT-LOCK — Variables de Entorno
# Copia este archivo a .env y completa los valores
# ──────────────────────────────────────────────

# ── Gemini (Google AI Studio) ──────────────────
# Obtén tu key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=PEGA_TU_KEY_AQUI

# ── Auth0 ──────────────────────────────────────
# Crea tu cuenta en: https://auth0.com (tier gratuito)
AUTH0_DOMAIN=TU_DOMINIO.us.auth0.com
AUTH0_CLIENT_ID=TU_CLIENT_ID
AUTH0_CLIENT_SECRET=TU_CLIENT_SECRET
AUTH0_AUDIENCE=https://agent-lock-api

# ── Telegram ───────────────────────────────────
# 1. Habla con @BotFather en Telegram → /newbot
# 2. Copia el token aquí
TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN
# 3. Habla con @userinfobot para obtener tu Chat ID
TELEGRAM_CHAT_ID=TU_CHAT_ID

# ── Servidor ───────────────────────────────────
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ── Seguridad ──────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_muy_segura

# ── Logs ───────────────────────────────────────
AUDIT_LOG_PATH=./logs/audit.jsonl
