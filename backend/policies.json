{
    "policies": [
        {
            "id": "policy_file_delete",
            "tool_pattern": ".*(file|fs|filesystem|storage|disk|FileSystem).*",
            "condition": ".*(delete|remove|unlink|rmdir|rm|erase|wipe|purge|trash).*",
            "action": "FORCE_PENDING",
            "risk_level": "HIGH",
            "description": "Any file deletion always requires manual human notification and approval."
        },
        {
            "id": "policy_shell_destructive",
            "tool_pattern": ".*(bash|shell|exec|terminal|cmd|command|run).*",
            "condition": ".*(rm |rm -rf|rmdir|del |delete|format|mkfs|dd |shred|wipe).*",
            "action": "FORCE_PENDING",
            "risk_level": "HIGH",
            "description": "Destructive shell commands always require approval."
        },
        {
            "id": "policy_email_connectors_via_exec",
            "tool_pattern": ".*(bash|shell|exec|terminal|cmd|command|run|http_request|send_email).*",
            "condition": ".*(smtp|gmail|sendmail|send[-_ ]?email|mailgun|resend|gog\\s+send).*",
            "action": "FORCE_PENDING",
            "risk_level": "HIGH",
            "description": "Email sending through connectors/exec wrappers requires explicit human approval."
        },
        {
            "id": "policy_db_destructive",
            "tool_pattern": "database.*",
            "condition": ".*(DROP|TRUNCATE|DELETE).*",
            "action": "FORCE_PENDING",
            "risk_level": "CRITICAL",
            "description": "Any database deletion requires mandatory human signature."
        },
        {
            "id": "policy_payments",
            "tool_pattern": ".*(pay|payment|transfer|bank|wallet|stripe).*",
            "condition": ".*",
            "action": "FORCE_PENDING",
            "risk_level": "CRITICAL",
            "description": "Money management always requires authorization."
        }
    ],
    "global_config": {
        "notification_channel": "telegram",
        "default_risk_level": "LOW"
    }
}