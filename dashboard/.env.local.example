# Agent-Lock AI using Gemini
# Copy to .env.local and set your key.

# Required (you can use either key variable)
AGENT_LOCK_GEMINI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GOOGLE_API_KEY=your_gemini_api_key

# Requested default model
AGENT_LOCK_GEMINI_MODEL=gemini-3.0-flash

# Optional: override full endpoint
# AGENT_LOCK_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.0-flash:generateContent?key=YOUR_KEY
